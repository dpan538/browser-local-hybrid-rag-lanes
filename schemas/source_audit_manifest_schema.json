{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpan538/browser-local-hybrid-rag-lanes/schemas/source_audit_manifest_schema.json",
  "title": "Source Audit Manifest Row",
  "type": "object",
  "required": [
    "audit_version",
    "fixture_target",
    "query_id",
    "record_id",
    "source_family_id",
    "source_name",
    "source_domain",
    "source_url",
    "metadata_url",
    "source_record_id",
    "record_origin",
    "source_audit_status",
    "audit_scope",
    "fields",
    "field_audit",
    "checked_at",
    "checked_by"
  ],
  "properties": {
    "audit_version": { "type": "string", "const": "paper_v1_source_audit_v0" },
    "fixture_target": { "type": "string", "enum": ["source_audited_50", "source_audited_100", "source_audited_200", "source_audited_300"] },
    "query_id": { "type": "string", "pattern": "^q[0-9]{3}$" },
    "record_id": { "type": "string", "minLength": 1 },
    "source_family_id": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string", "minLength": 1 },
    "source_domain": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "metadata_url": { "type": "string", "format": "uri" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "record_origin": {
      "type": "string",
      "enum": ["source_audited", "derived_from_public_source"]
    },
    "source_audit_status": {
      "type": "string",
      "enum": ["pass", "fail", "uncertain"]
    },
    "audit_scope": {
      "type": "string",
      "enum": ["metadata_only_no_image_download"]
    },
    "fields": {
      "type": "object",
      "required": [
        "title",
        "date_text",
        "source",
        "source_citation",
        "rights_label",
        "reuse_permission",
        "public_domain_status",
        "image_state_label"
      ],
      "properties": {
        "title": { "type": "string" },
        "date_text": { "type": "string" },
        "source": { "type": "string" },
        "source_citation": { "type": "string" },
        "rights_label": { "type": "string" },
        "reuse_permission": { "type": "string" },
        "public_domain_status": { "type": "string" },
        "image_state_label": { "type": "string" }
      },
      "additionalProperties": false
    },
    "field_audit": {
      "type": "object",
      "required": [
        "title",
        "date_text",
        "source",
        "source_citation",
        "rights_label",
        "reuse_permission",
        "public_domain_status",
        "image_state_label"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/field_state" },
        "date_text": { "$ref": "#/$defs/field_state" },
        "source": { "$ref": "#/$defs/field_state" },
        "source_citation": { "$ref": "#/$defs/field_state" },
        "rights_label": { "$ref": "#/$defs/field_state" },
        "reuse_permission": { "$ref": "#/$defs/field_state" },
        "public_domain_status": { "$ref": "#/$defs/field_state" },
        "image_state_label": { "$ref": "#/$defs/field_state" }
      },
      "additionalProperties": false
    },
    "audit_notes": { "type": "string" },
    "checked_at": { "type": "string", "format": "date-time" },
    "checked_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "field_state": {
      "type": "string",
      "enum": ["verified", "missing", "conflicting", "not_applicable"]
    }
  },
  "additionalProperties": false
}
