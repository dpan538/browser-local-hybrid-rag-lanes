{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dpan538/browser-local-hybrid-rag-lanes/schemas/source_audit_manifest_schema.json",
  "title": "Source Audit Manifest Row",
  "type": "object",
  "required": [
    "audit_version",
    "manifest_id",
    "fixture_target",
    "query_id",
    "record_id",
    "source_family_id",
    "source_name",
    "source_domain",
    "source_url",
    "metadata_url",
    "source_record_id",
    "record_origin",
    "source_audit_status",
    "audit_scope",
    "fields",
    "checked_at",
    "checked_by"
  ],
  "properties": {
    "audit_version": { "type": "string", "const": "paper_v1_source_audit_v0" },
    "manifest_id": { "type": "string", "pattern": "^sa_[a-z0-9_\\-]+$" },
    "fixture_target": {
      "type": "string",
      "enum": [
        "source_audited_50",
        "source_audited_100",
        "source_audited_200",
        "source_audited_300"
      ]
    },
    "query_id": { "type": "string", "pattern": "^q[0-9]{3}$" },
    "record_id": { "type": "string", "minLength": 1 },
    "source_family_id": { "type": "string", "minLength": 1 },
    "source_name": { "type": "string", "minLength": 1 },
    "source_domain": { "type": "string", "minLength": 1 },
    "source_url": { "type": "string", "format": "uri" },
    "metadata_url": { "type": "string", "format": "uri" },
    "source_record_id": { "type": "string", "minLength": 1 },
    "record_origin": {
      "type": "string",
      "enum": ["source_audited", "derived_from_public_source"]
    },
    "source_audit_status": {
      "type": "string",
      "enum": ["audited", "partial", "failed"]
    },
    "audit_scope": {
      "type": "string",
      "enum": ["metadata_only_no_image_download"]
    },
    "fields": {
      "type": "object",
      "required": [
        "title",
        "date_text",
        "source",
        "source_citation",
        "rights_label",
        "reuse_permission",
        "public_domain_status",
        "image_state_label"
      ],
      "properties": {
        "title": { "$ref": "#/$defs/audited_field" },
        "date_text": { "$ref": "#/$defs/audited_field" },
        "source": { "$ref": "#/$defs/audited_field" },
        "source_citation": { "$ref": "#/$defs/audited_field" },
        "rights_label": { "$ref": "#/$defs/audited_field" },
        "reuse_permission": { "$ref": "#/$defs/audited_field" },
        "public_domain_status": { "$ref": "#/$defs/audited_field" },
        "image_state_label": { "$ref": "#/$defs/image_state_field" }
      },
      "additionalProperties": false
    },
    "auditor_notes": { "type": "string" },
    "checked_at": { "type": "string", "format": "date-time" },
    "checked_by": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "field_state": {
      "type": "string",
      "enum": ["verified", "missing", "conflicting", "not_applicable"]
    },
    "audited_field": {
      "type": "object",
      "required": ["state", "value", "evidence_note"],
      "properties": {
        "state": { "$ref": "#/$defs/field_state" },
        "value": { "type": "string" },
        "evidence_note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "image_state_field": {
      "type": "object",
      "required": ["state", "value", "evidence_note"],
      "properties": {
        "state": { "$ref": "#/$defs/field_state" },
        "value": {
          "type": "string",
          "enum": [
            "",
            "image_public_domain",
            "image_restricted",
            "image_copyrighted",
            "image_rights_unknown",
            "no_image_available",
            "metadata_only_not_applicable"
          ]
        },
        "evidence_note": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
